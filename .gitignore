# local data: Treg token, logins, and billing stay on the machine.
# signals.db is tracked so production can pull the same listeners and leads.
data/*
!data/signals.db

# secrets / environment files — never commit
.env
.env.*
*.env
!.env.example
*.pem
*.key
secrets.*

# python
__pycache__/
*.pyc
.venv/
venv/
